  {
    "id": "challenge",
    "num": "03",
    "label": "The challenge",
    "title": "Many learning and trivia applications struggle to keep users engaged after the first few interactions.",
    "lead": "As a result, users often abandon learning platforms before developing long-term habits.",
    "board": {
      "src": "assets/img/case-studies/lumora/04-challenge.webp",
      "width": 1399,
      "height": 699
    },
    "blocks": [
      {
        "type": "list",
        "title": "Common challenges included",
        "items": [
          "Low retention rates",
          "Repetitive learning experiences",
          "Lack of meaningful rewards",
          "Weak competitive elements",
          "Limited personalization",
          "Poor visibility of progress"
        ]
      }
    ]
  },
  {
    "id": "goal",
    "num": "04",
    "label": "The goal",
    "title": "The primary objective was to design a platform that motivates users to learn consistently through engagement, competition, and rewards.",
