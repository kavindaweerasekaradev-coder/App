[
  {
    "id": "overview",
    "num": "01",
    "label": "Overview",
    "title": "Transforming learning into an engaging trivia experience.",
    "lead": "Lumora is a mobile-first trivia platform designed to make learning more engaging, interactive, and rewarding. By combining knowledge-based challenges with gamification mechanics, users can test their skills, compete with others, earn achievements, and track their growth through a seamless mobile experience.",
    "blocks": [
      {
        "type": "quote",
        "label": "The idea",
        "text": "The goal was to create an experience that feels less like studying and more like playing, encouraging users to return daily and continuously expand their knowledge."
      },
      {
        "type": "image",
        "src": "assets/img/case-studies/lumora/01-mockup.webp",
        "alt": "Lumora home screen on an iPhone",
        "width": 1320,
        "height": 933
      },
      {
        "type": "image",
        "src": "assets/img/case-studies/lumora/02-brand.webp",
